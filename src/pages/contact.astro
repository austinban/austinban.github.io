        <h1>Pick your poison.</h1>
        <div class="small-12">
          <a href="mailto:banaustinban@gmail.com" class="round-button">Email <i class="fa fa-envelope" aria-hidden="true"></i></a>
          <a target="_blank" href="https://www.linkedin.com/in/austin-ban-4b719a89" class="round-button">Linkedin&nbsp;<i class="fa fa-linkedin" aria-hidden="true"></i></a>
          <a target="_blank" href="https://github.com/austinban" class="round-button">Github&nbsp;<i class="fa fa-github" aria-hidden="true"></i></a>
        </div>
      </div>
    </div>
  </div>
</Layout>
