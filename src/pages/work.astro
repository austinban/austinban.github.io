---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Work | Austin Ban">
  <div class="gradient-block2">
    <div class="text-block">
      <div class="small-12">
        <h1 class="huge heading-pad" style="text-align: center;">Here are a few jobs I'm proud&nbsp;of.</h1>
      </div>
    </div>
  </div>

  <div class="index-block">
    <div class="text-block crystal-window">
      <div class="small-12" data-aos="flip-up" data-aos-once="true" data-aos-duration="700">
        <h1>4+ years of experience in a growing startup.</h1>
        <p>
          I have spent over 4 years working in the fast changing environment of a tech startup.
          Crystal Knows is a technology based around personality types that aims to enable users to better understand themselves and others.
        </p>
        <a href="/crystal" class="round-button">Read about it <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </div>

  <div class="index-block">
    <div class="text-block mobile-app-window">
      <div class="small-12" data-aos="flip-up" data-aos-once="true" data-aos-duration="700">
        <h1>Mobile app development for Android and iOS.</h1>
        <p>
          A task I undertook was to build the mobile app version of Crystal Knows for both Android and iOS.
          This app has averaged 4.5 stars with 150+ reviews across both platforms.
        </p>
        <a href="/mobile-app" class="round-button">Read about it <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </div>

  <div class="index-block">
    <div class="text-block freelance-window">
      <div class="small-12" data-aos="flip-up" data-aos-once="true" data-aos-duration="700">
        <h1>Freelance projects that span the spectrum.</h1>
        <p>
          Over the years, I have worked with a variety of clients to meet an array of needs.
        </p>
        <a href="/freelance" class="round-button">Read about it <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </div>
</Layout>
