---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Alpaca | Austin Ban">
  <div class="gradient-block2" style="min-height: 100vh;">
    <div class="text-block">
      <div class="small-12" style="text-align: center;" data-aos="flip-up" data-aos-once="true" data-aos-duration="700">
        <div class="case-image">
          <img src="/images/alpaca.jpg" alt="An alpaca" loading="lazy" />
        </div>
        <h1>You're welcome</h1>
      </div>
    </div>
  </div>
</Layout>
