---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Austin Ban | Nashville based web developer, web designer, and storyteller" showFooterTopper={false}>
  <a id="awwwards-img" href="http://www.awwwards.com/" aria-label="Awwwards Site Of The Day Nominee"></a>
  <div id="tsparticles" class="hero-section"></div>
  <div class="huge-wrap">
    <div class="text">
      <h1 class="huge constrain">I create solutions to people's problems.</h1>
      <p>I'm a frontend developer, designer, and storyteller.</p>
    </div>
  </div>
  <div class="down-arrow bounce" style="height: 0;">
    <a href="#workSection"><i class="fa fa-arrow-down" aria-hidden="true"></i></a>
  </div>

  <div id="workSection" class="index-block profile-window">
    <div class="text-block">
      <div class="small-12">
        <h1 data-aos="flip-up" data-aos-once="true" data-aos-duration="700">
          My name is Austin Ban, and I live in the rolling mountains of Joelton, TN. In everything I am part of creating, my goal is to spark joy in both the users and my collaborators.
        </h1>
        <a href="/about" class="round-button" data-aos="flip-up" data-aos-once="true" data-aos-duration="700">More about me <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </div>

  <div class="index-block">
    <div class="text-block crystal-window">
      <div class="small-12" data-aos="flip-up" data-aos-once="true" data-aos-duration="700">
        <h1>4+ years of experience in a growing startup.</h1>
        <p>
          I have spent over 4 years working in the fast changing environment of a tech startup.
          Crystal Knows is a technology based around personality types that aims to enable users to better understand themselves and others.
          In the time I have spent there, we have undergone extremely rapid change, teaching me to pivot quickly and plan for the unpredictable future.
        </p>
        <a href="/crystal" class="round-button">Read about it <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </div>

  <div class="index-block">
    <div class="text-block mobile-app-window">
      <div class="small-12" data-aos="flip-up" data-aos-once="true" data-aos-duration="700">
        <h1>Mobile app development for Android and iOS.</h1>
        <p>
          A task I undertook was to build the mobile app version of Crystal Knows for both Android and iOS.
          This app has averaged 4.5 stars with 150+ reviews across both platforms.
        </p>
        <a href="/mobile-app" class="round-button">Read about it <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </div>

  <div class="index-block">
    <div class="text-block freelance-window">
      <div class="small-12" data-aos="flip-up" data-aos-once="true" data-aos-duration="700">
        <h1>Freelance projects that span the spectrum.</h1>
        <p>
          Over the years, I have worked with a variety of clients to meet an array of needs. This work with such a diverse cast
          has taught me the importance of communication, and working closely with the clients to ensure they get the ideal end-product.
          This includes scratch built sites, as well as several made using site builders, such as Shopify, Squarespace, Wordpress, etc...
        </p>
        <a href="/freelance" class="round-button">Read about it <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </div>

  <div class="index-block profile-window">
    <div class="text-block">
      <div class="small-12">
        <h1 data-aos="flip-up" data-aos-once="true" data-aos-duration="700">
          I'm super glad you're here!
          Here are some fun factoids about my past and present self so you can get to know me a little better.
        </h1>
        <div class="no-padding row" data-aos="flip-up" data-aos-once="true" data-aos-duration="700">
          <div class="small-12 medium-6 columns">
            <div class="small-12 medium-12 large-6 columns">
              <h2>Work</h2>
              <ul>
                <li><a href="https://www.crystalknows.com/">Crystal frontend developer&nbsp;<i class="fa fa-link" aria-hidden="true"></i></a></li>
                <li><a href="/freelance">Freelance development work&nbsp;<i class="fa fa-link" aria-hidden="true"></i></a></li>
                <li><a href="/mobile-app">Mobile app development&nbsp;<i class="fa fa-link" aria-hidden="true"></i></a></li>
                <li>Venture360 contract work</li>
                <li><a target="_blank" href="http://www.soundyeti.com/">Sound Yeti interface design&nbsp;<i class="fa fa-link" aria-hidden="true"></i></a></li>
                <li>Alpaca waste management (Mucker)</li>
              </ul>
            </div>
            <div class="small-12 medium-12 large-6 columns">
              <h2>Education</h2>
              <ul>
                <li><a target="_blank" href="http://www.belmont.edu/">BS in Computer Science from Belmont University&nbsp;<i class="fa fa-link" aria-hidden="true"></i></a></li>
                <li><a target="_blank" href="http://www.belmont.edu/">Minor in Entrepreneurship from Belmont University&nbsp;<i class="fa fa-link" aria-hidden="true"></i></a></li>
                <li>My mom (homeschooled)</li>
              </ul>
            </div>
          </div>
          <div class="small-12 medium-6 columns">
            <div class="small-12 medium-12 large-6 columns">
              <h2>Personality</h2>
              <ul>
                <li><a target="_blank" href="https://www.16personalities.com/enfp-personality">Myers-Briggs ENFP&nbsp;<i class="fa fa-link" aria-hidden="true"></i></a></li>
                <li><a target="_blank" href="https://www.enneagraminstitute.com/type-7/">Enneagram 7&nbsp;<i class="fa fa-link" aria-hidden="true"></i></a></li>
                <li>Enthusiastic dad energy</li>
              </ul>
            </div>
            <div class="small-12 medium-12 large-6 columns">
              <h2>Hobbies</h2>
              <ul>
                <li><a target="_blank" href="https://babyknives.com/">Custom Knives&nbsp;<i class="fa fa-link" aria-hidden="true"></i></a></li>
                <li>Over-engineered trivia</li>
                <li>Homesteading</li>
                <li>Bouldering (rock climbing)</li>
                <li>Backpacking</li>
              </ul>
            </div>
          </div>
        </div>
        <a href="/about" class="round-button" data-aos="flip-up" data-aos-once="true" data-aos-duration="700">Intrigued? Find out more <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </div>

  <div class="gradient-block">
    <div class="text-block" style="text-align: center;" data-aos="flip-up" data-aos-once="true" data-aos-duration="700">
      <div class="small-12">
        <h1 class="huge">Let's make something beautiful and empower others to tell their&nbsp;story.</h1>
        <a href="/contact" class="round-button">Contact Me <i class="fa fa-long-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </div>


<script>
  import { tsParticles } from '@tsparticles/engine';
  import { loadSlim } from '@tsparticles/slim';

  await loadSlim(tsParticles);

  await new Promise<void>(resolve => requestAnimationFrame(() => resolve()));

  await tsParticles.load({
    id: 'tsparticles',
    options: {
      fullScreen: { enable: false },
      background: { color: { value: 'transparent' } },
      fpsLimit: 120,
      particles: {
        number: { value: 80, density: { enable: true, width: 800 } },
        paint: {
          fill: { color: { value: '#eeab12' }, enable: true, opacity: 1 },
        },
        shape: { type: 'circle' },
        size: { value: { min: 10, max: 20 } },
        links: { enable: false },
        move: {
          enable: true,
          speed: 3,
          direction: 'top',
          random: false,
          straight: false,
          outModes: { default: 'out' },
        },
      },
      interactivity: {
        detectsOn: 'canvas',
        events: {
          onHover: { enable: true, mode: 'repulse' },
          onClick: { enable: true, mode: 'push' },
          resize: { enable: true },
        },
        modes: {
          repulse: { distance: 200, duration: 0.4 },
          push: { quantity: 4 },
        },
      },
      detectRetina: true,
    },
  });
</script>
</Layout>
